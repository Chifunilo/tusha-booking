# Copy this file to .env and fill in real values.
# This app is the frontend only — the database, auth, and Cloudinary uploads
# are all handled by the tusha-booking-backend service. See its README for setup.

# Base URL of the tusha-booking-backend API (no trailing slash).
# Baked into the client bundle at build time — see Dockerfile.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Must match the backend's JWT_SECRET exactly — this app verifies the same
# tokens locally (in middleware.ts) without calling the backend.
# Generate with: openssl rand -base64 48
JWT_SECRET=
